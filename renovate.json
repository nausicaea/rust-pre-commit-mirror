{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices"
    ],
    "assignees": ["nausicaea"],
    "minimumReleaseAge": "7d",
    "rangeStrategy": "pin",
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": ["on monday"]
    },
    "customManagers": [
        {
            "customType": "regex",
            "description": "Update Rust CLI tools installed by pre-commit",
            "managerFilePatterns": [
                "/(^|/)\\.pre-commit-hooks\\.ya?ml$/"
            ],
            "matchStrings": [
                "cli:(?<depName>cargo-[a-z0-9-]+):(?<currentValue>[0-9]+(?:\\.[0-9]+){1,2})"
            ],
            "datasourceTemplate": "crate",
            "versioningTemplate": "cargo"
        }
    ]
}
